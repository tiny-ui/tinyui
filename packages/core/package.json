{
  "name": "tinyui-core",
  "version": "0.7.0",
  "description": "TinyUI runtime: signals, ownership, h/For/Show, patch emission.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./assets": {
      "types": "./assets.d.ts"
    }
  },
  "files": [
    "dist",
    "assets.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiny-ui/tinyui.git",
    "directory": "packages/core"
  },
  "sideEffects": false
}
